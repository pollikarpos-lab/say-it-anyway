# ─────────────────────────────────────────────────────────────
#  Say It Anyway — приклад змінних середовища
#  НІКОЛИ не кладіть справжні ключі в цей файл і в клієнтський код.
#  Ключі живуть ТІЛЬКИ на сервері (див. docs/PROVIDERS.md).
# ─────────────────────────────────────────────────────────────

# Режим провайдерів: mock | http
# mock — усе працює локально без ключів (режим за замовчуванням)
# http — клієнт б'є у ВАШ власний бекенд-проксі (не напряму в OpenAI/інше)
VITE_PROVIDER_MODE=mock

# Базовий URL вашого бекенд-проксі. Клієнт звертається тільки сюди.
# Проксі всередині себе тримає ключі й ходить у STT/LLM/TTS.
VITE_API_BASE_URL=http://localhost:8787

# ── Наступні змінні читає ТІЛЬКИ сервер-проксі, не браузер ──
# STT_PROVIDER=openai
# STT_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=
# TTS_PROVIDER=elevenlabs
# TTS_API_KEY=

# Аналітика (події без змісту відповіді). Порожньо = тільки локальний лог.
# ANALYTICS_ENDPOINT=
