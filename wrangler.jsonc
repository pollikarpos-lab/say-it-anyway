{
  // Конфігурація для Cloudflare Workers зі статичними файлами.
  //
  // Потрібна тільки тому, що Cloudflare переводить нові проєкти з Pages на
  // Workers. Для класичного Pages цей файл не використовується й не заважає:
  // там усе задається в інтерфейсі (build command + output directory).
  //
  // Жодного серверного коду тут немає — Worker лише роздає вміст dist/.
  // Коли з'явиться справжній бекенд (STT/LLM/TTS-проксі), він житиме
  // окремо, а не тут: див. docs/PROVIDERS.md.
  "name": "say-it-anyway",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./dist"
  }
}
