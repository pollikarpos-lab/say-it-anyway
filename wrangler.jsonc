{
  // Розгортання на Cloudflare: один Worker роздає і сайт, і бекенд-проксі.
  //
  // Чому разом, а не окремо: фронтенд і /api опиняються на одному домені,
  // тож немає ні CORS, ні другого сервера, ні окремого рахунку. Запити до
  // /api/* обробляє worker/index.js, решту — готові файли з dist/.
  //
  // Ключі тут НЕ зберігаються. Вони живуть у сховищі секретів Cloudflare
  // (Settings → Variables and Secrets) і потрапляють у код лише як
  // env.OPENAI_API_KEY під час виконання.
  "name": "say-it-anyway",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Сховище подій аналітики. Ім'я прив'язки мусить бути саме DB — воркер
  // читає env.DB. Таблиця створюється сама при першій події, міграцій
  // руками не треба.
  //
  // Прив'язки живуть ТУТ, а не в панелі: деплой іде з репозиторію, і
  // кожна збірка перезаписує те, що виставлене кліком у дашборді.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "say-it-anyway",
      "database_id": "f65ddbff-8071-42e9-8432-4ed25cddbb8f"
    }
  ],
  "observability": {
    "enabled": true
  }
}
